# ============================================================================
# Guardian Angel Compliance Monitor — environment variables
# ============================================================================
# Copy this file to `.env` and fill in the values you need.
#
# PROTOTYPE MINIMUM: the only variable you MUST set to run a local demo is
# OPENROUTER_API_KEY. Everything else has a safe default.
# ============================================================================

# ---- Required in all modes ----

# Get one at https://openrouter.ai/keys — paste the sk-or-... string here.
OPENROUTER_API_KEY=

# ---- Optional / defaulted in prototype ----

# Pinned Lightweight-tier model. Verified at boot against
# https://openrouter.ai/api/v1/models — must support response_format.
#
# Day-1 default (April 2026):  google/gemini-flash-lite-2.0
# Fallback candidate:          openai/gpt-5.4-nano
# Re-verify current Lightweight-tier options at implementation time;
# the catalog shifts. Swap with this env var only — no code change.
OPENROUTER_MODEL=google/gemini-flash-lite-2.0

# SQLite file path. Local default ./dev.db; on Railway use /data/gam.db.
DATABASE_PATH=./dev.db

# Public base URL. For local dev leave as http://localhost:3000.
APP_URL=http://localhost:3000

# Prototype mode toggle. Defaults to true. Set to false ONLY in production.
PROTOTYPE_MODE=true
# Defaults to match PROTOTYPE_MODE. When true, the AI classifier uses a
# deterministic in-process stub (no OpenRouter calls). Set to false when
# wiring a paid model — you'll also want OPENROUTER_API_KEY + OPENROUTER_MODEL.
PROTOTYPE_STUB_CLASSIFIER=true

# Cookie-signing secret. Auto-generated on first `npm run seed` if absent
# and persisted back to this file. Set explicitly in production.
BETTER_AUTH_SECRET=

# ---- Demo login (prototype only) ----
#
# IMPORTANT: the config loader refuses to boot if DEMO_LOGIN_PASSWORD is
# still the default "demo" AND APP_URL points to anything other than
# http://localhost or http://127.0.0.1. For any public or Railway deploy
# you MUST set a strong DEMO_LOGIN_PASSWORD. This guard exists because
# seeded PHI-shaped synthetic data lives behind this login.
DEMO_LOGIN_EMAIL=demo@lowesguardianangel.com
DEMO_LOGIN_PASSWORD=demo

# Log verbosity. One of: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# HTTP port (Railway injects its own; local default 3000).
PORT=3000

# ---- Production only — leave blank in prototype ----

# Therap SFTP (post-BAA / post-Trading-Partner-Agreement).
# Request from Therap GA support: gasupport@therapservices.net
THERAP_SFTP_HOST=
THERAP_SFTP_USER=
THERAP_SFTP_PRIVATE_KEY_PATH=

# Transactional email (Resend or equivalent).
EMAIL_API_KEY=

# Google Workspace SSO. Provision in Google Cloud Console on the
# lowesguardianangel.com tenant; server-side `hd` claim verification
# enforces the domain restriction at callback time.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

